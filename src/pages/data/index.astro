---
import BaseLayout from '../../layouts/BaseLayout.astro';
import index from '../../../data/reddit-index-2026-10.json';

const supps = Object.entries(index.supplements).sort((a: any, b: any) => b[1].posts - a[1].posts);
const generated = new Date(index.generated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Sleep Supplement Reality Index',
  description:
    'Original, continuously-updated dataset of community-reported outcomes for twelve sleep supplements, mined from top posts across five sleep communities on Reddit. Includes mention volume, user approval rate, and form preferences.',
  url: 'https://naturallyrestful.xyz/data/',
  creator: { '@type': 'Organization', name: 'Naturally Restful', url: 'https://naturallyrestful.xyz' },
  license: 'https://naturallyrestful.xyz/press#citing',
  isAccessibleForFree: true,
  keywords: ['sleep supplements', 'Reddit', 'community outcomes', 'glycine', 'ashwagandha', 'magnesium glycinate', 'melatonin'],
  temporalCoverage: '2026-09/..',
  variableMeasured: ['mention volume (posts)', 'user approval (% positive of outcome posts)', 'form preference'],
};
---

<BaseLayout
  title="Sleep Supplement Reality Index"
  description="An original, continuously-updated dataset: what thousands of Reddit posts actually say about sleep supplements — mention volume, user approval, and the forms people settle on."
>
  <script type="application/ld+json" set:html={JSON.stringify(datasetSchema)} />
  <div class="container">
    <h1 class="page-title">The Sleep Supplement Reality Index</h1>
    <p class="lead">
      Clinical trials tell you what works under controlled conditions. Reddit tells you what people
      actually experience, in their own words, at their own doses. The Reality Index is our original
      dataset covering both halves — built by mining every top post about twelve sleep supplements
      across five sleep communities. Cited by us, citable by anyone.
    </p>

    <a class="report-card" href="/data/2026-10">
      <span class="tag">Latest report</span>
      <strong>Report #002 — October 2026</strong>
      <span>1,645 posts re-scored. The September ranking held almost perfectly — glycine still 97%, ashwagandha still last. One mover: tart cherry.</span>
      <span class="go">Read the report →</span>
    </a>

    <div class="prose">
      <h2>Current standings (October 2026)</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Supplement</th><th class="num">Posts</th><th class="num">User approval</th></tr></thead>
          <tbody>
            {supps.map(([name, r]: any) => (
              <tr><td>{name}</td><td class="num">{r.posts}</td><td class="num">{r.approvalPct}%</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">Approval = positive ÷ (positive + negative) posts containing explicit outcome language. Dataset generated {generated} · <a href="/data/2026-09">September edition</a>.</p>

      <div class="community-box">
        <h2>Community Notes — your outcome, in the next edition</h2>
        <p>
          Took something we track? <a href="/contact">Send us your outcome</a> — supplement, dose, weeks tried,
          and your honest verdict (worked / nothing / side effects). The best entries get quoted by name in the
          next monthly edition, alongside the Reddit data. Real outcomes from real readers: that's the index, grown up.
        </p>
      </div>

      <h2>Why we publish this</h2>
      <p>
        Most supplement content is written from the same ten studies, or from nothing at all. Community
        experience is the missing dataset — nobody had packaged it, so we did. If you write about sleep
        supplements and want a citable number for what users report, this page is the source.
      </p>
      <p>
        Writing about sleep more broadly? Our <a href="/sleep-statistics">sleep statistics hub</a> collects
        the most-cited numbers from CDC, RAND, and clinical research — each with its original source.
        Journalists and bloggers can grab <a href="/press">ready-made citation formats and embeds here</a>.
      </p>

      <h2>Editions</h2>
      <ul>
        <li><a href="/data/2026-10">October 2026 — Report #002</a> (current)</li>
        <li><a href="/data/2026-09">September 2026 — Report #001</a> (baseline edition)</li>
      </ul>
      <p class="fine">New edition monthly. Trend lines begin with the October 2026 report.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .report-card { display: block; background: #f4f1ea; border-radius: 12px; padding: 1.2rem 1.4rem; margin: 1.8rem 0 2.4rem; color: inherit; text-decoration: none; }
  .report-card:hover { background: #ece7db; }
  .report-card strong { display: block; font-size: 1.15rem; margin: 0.5rem 0 0.3rem; }
  .report-card span { display: block; color: #555; font-size: 0.95rem; }
  .report-card .tag { display: inline-block; background: #33517a; color: #fff; border-radius: 999px; padding: 0.15rem 0.7rem; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .report-card .go { color: #33517a; font-weight: 600; margin-top: 0.5rem; }
  .table-wrap { overflow-x: auto; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.5rem 0.7rem; border-bottom: 1px solid #e5e2da; }
  th { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: #666; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .fine { font-size: 0.85rem; color: #777; }
  .community-box { background: #f9f2ec; border-left: 4px solid #b0793c; padding: 1rem 1.3rem; border-radius: 8px; margin: 1.8rem 0; }
  .community-box h2 { margin: 0 0 .4rem; font-size: 1.1rem; }
</style>
