---
import BaseLayout from '../layouts/BaseLayout.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'The Researcher',
  url: 'https://naturallyrestful.xyz/author',
  jobTitle: 'Founder & Researcher',
  worksFor: { '@type': 'Organization', name: 'Naturally Restful', url: 'https://naturallyrestful.xyz' },
  knowsAbout: ['sleep supplements', 'ashwagandha', 'magnesium glycinate', 'glycine', 'melatonin', 'L-theanine'],
};
---
<BaseLayout
  title="The Author"
  description="The Researcher — the byline behind Naturally Restful. Honest about what this site is and isn't."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <div class="container">
    <h1 class="page-title">The Researcher</h1>
    <p class="lead">Founder &amp; researcher, Naturally Restful.</p>

    <div class="prose">
      <p>
        I publish under a byline rather than my legal name — the standards on this page are the
        accountability, not the name. I started Naturally Restful after noticing that every search about sleep
        supplements returned the same recycled marketing. I'm not a doctor and I don't pretend
        to be one — I'm a researcher who reads the actual trials, links them, and translates
        them into plain English.
      </p>

      <h2>What I do</h2>
      <ul>
        <li>Read the human trials behind every claim (and link the boring details).</li>
        <li>Test products personally where safe and practical, always disclosing that context.</li>
        <li>Update articles when the evidence changes — visible "Updated" dates, not silent edits.</li>
      </ul>

      <h2>What I don't do</h2>
      <ul>
        <li>Give medical advice. For that, see a qualified clinician — seriously.</li>
        <li>Accept payment to feature or rank a product.</li>
        <li>Publish claims a supplement can diagnose, treat, cure, or prevent disease — that's both wrong and, in the US/EU, illegal.</li>
      </ul>

      <h2>The long-term plan</h2>
      <p>
        As the site grows, the goal is to bring credentialed reviewers (pharmacists, sleep
        scientists) onto articles — and to say clearly, per article, who reviewed what. Trust
        is earned in the open or not at all.
      </p>

      <p>
        Want to talk? <a href="/contact">Get in touch</a> — I read everything.
      </p>
    </div>
  </div>
</BaseLayout>
