---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist — but plenty of good sleep content does."
>
  <div class="container" style="text-align:center; padding-top:4rem;">
    <h1 class="page-title">404 — asleep at the wheel</h1>
    <p class="lead">That page doesn't exist (or moved). Try one of these instead:</p>
    <p>
      <a class="btn" href="/">Home</a>&nbsp;
      <a class="btn" href="/articles">All articles</a>&nbsp;
      <a class="btn" href="/best-sleep-supplements">Best sleep supplements</a>
    </p>
  </div>
</BaseLayout>
