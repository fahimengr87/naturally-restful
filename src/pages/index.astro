---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailOptin from '../components/EmailOptin.astro';
import AffiliateBox from '../components/AffiliateBox.astro';

const latest = (await getCollection('articles'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Naturally Restful',
  url: 'https://naturallyrestful.xyz',
  description: 'Honest, research-aware guides to sleep and stress supplements.',
};
---
<BaseLayout
  title="Naturally Restful"
  description="Honest, research-aware guides to sleep and stress supplements. What works, what doesn't, and what the industry won't tell you."
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <section class="hero container">
    <p class="eyebrow">Sleep · Stress · Supplements</p>
    <h1>Better sleep, without the hype.</h1>
    <p>
      We read the research on sleep and stress supplements so you don't have to —
      then tell you exactly what works, what doesn't, and who shouldn't take it.
    </p>
    <a class="btn" href="/best-sleep-supplements">See the best sleep supplements →</a>
  </section>

  <section class="container wide">
    <h2 class="section-title">Why readers trust us</h2>
    <div class="trust-strip">
      <div class="trust-item"><strong>Research-cited, always</strong> Claims trace back to published human trials — and we link the boring details.</div>
      <div class="trust-item"><strong>No sponsored posts</strong> No brand pays to appear or to be ranked. Commissions are the same whatever you choose.</div>
      <div class="trust-item"><strong>We name the weaknesses</strong> Every article says who shouldn't take a supplement and what the evidence doesn't show.</div>
      <div class="trust-item"><strong>Disclosed on every page</strong> Affiliate relationships are stated plainly, per FTC rules — no fine print games.</div>
    </div>

    <h2 class="section-title">Start here</h2>
    <div class="card-grid">
      <a class="card" href="/best-sleep-supplements">
        <h3>Best Sleep Supplements</h3>
        <p>Our current top picks, how they compare, and the one we'd start with.</p>
      </a>
      <a class="card" href="/articles/magnesium-glycinate-vs-citrate-for-sleep">
        <h3>Magnesium for Sleep</h3>
        <p>Glycinate vs. citrate — which form actually helps sleep, and which is marketing.</p>
      </a>
      <a class="card" href="/articles/ashwagandha-for-stress-what-the-research-says">
        <h3>Stress &amp; Calm</h3>
        <p>What ashwagandha can realistically do for daily stress, according to trials.</p>
      </a>
    </div>

    <h2 class="section-title">Today's top picks</h2>
    <p style="color:var(--ink-soft);font-size:0.95rem;margin:-0.5rem 0 1.2rem">
      Our current recommendations for the three most common sleep problems —
      full reasoning in the <a href="/best-sleep-supplements">complete comparison</a>.
    </p>
    <div class="card-grid">
      <AffiliateBox
        badge="Best overall"
        name="Magnesium Glycinate"
        slug="magnesium-glycinate"
        blurb="The most sensible first try for general sleep quality — gentle, well-studied, modest effects."
        points={["Gentle on the stomach — safe at bedtime", "200–400 mg matches the trial doses", "Effects build over 2–4 weeks"]}
      />
      <AffiliateBox
        badge="For stress"
        name="CortiSync — KSM-66"
        slug="ashwagandha"
        blurb="300mg KSM-66 ashwagandha — the extract behind the cortisol trials. Clinically formulated for stress management."
        points={["Cortisol dropped 27.9% in trials", "300mg KSM-66 per serving", "Not for pregnancy or thyroid meds (ask your doctor)"]}
      />
      <AffiliateBox
        badge="For a racing mind"
        name="L-Theanine 200 mg"
        slug="l-theanine"
        blurb="Same-day calm without sedation — the pick for midnight mental to-do lists."
        points={["Works within about an hour", "No grogginess, no build-up", "Smooths out coffee jitters, too"]}
      />
    </div>

    <h2 class="section-title">Latest articles</h2>
    <div class="card-grid">
      {latest.map((a) => (
        <a class="card" href={`/articles/${a.id}`}>
          <h3>{a.data.title}</h3>
          <p>{a.data.description}</p>
          <div class="card-meta">{dateFmt(a.data.pubDate)}</div>
        </a>
      ))}
    </div>
  </section>

  <div class="container">
    <EmailOptin />
  </div>
</BaseLayout>
