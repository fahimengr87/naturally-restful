---
import BaseLayout from '../layouts/BaseLayout.astro';

// Every statistic below is attributed to its original publisher. Sources are
// linked at domain level (stable URLs) and named study/survey + year in text,
// so writers can verify before citing.

const stats = [
  {
    section: 'How much America sleeps',
    items: [
      {
        figure: '1 in 3',
        text: 'US adults report regularly getting less than the recommended 7 hours of sleep per night.',
        source: 'CDC, Behavioral Risk Factor Surveillance System',
        link: 'https://www.cdc.gov/sleep/',
      },
      {
        figure: '50–70 million',
        text: 'US adults are estimated to live with a sleep disorder (Institute of Medicine estimate, cited by the CDC).',
        source: 'CDC / Institute of Medicine',
        link: 'https://www.cdc.gov/sleep/',
      },
      {
        figure: '1 in 25',
        text: 'adult drivers report having fallen asleep while driving in the previous 30 days.',
        source: 'CDC, Behavioral Risk Factor Surveillance System',
        link: 'https://www.cdc.gov/sleep/',
      },
    ],
  },
  {
    section: 'Insomnia worldwide',
    items: [
      {
        figure: '~1 in 3',
        text: 'adults worldwide report at least one insomnia symptom — trouble falling asleep, staying asleep, or waking too early.',
        source: 'International epidemiological reviews (Ohayon et al.)',
        link: 'https://www.sleepfoundation.org/',
      },
      {
        figure: '~10%',
        text: 'of adults meet the criteria for chronic insomnia disorder — symptoms at least three nights a week for three months or more.',
        source: 'American Academy of Sleep Medicine / Sleep Foundation',
        link: 'https://www.sleepfoundation.org/',
      },
      {
        figure: '~30 million',
        text: 'Americans are estimated to have obstructive sleep apnea — and a large majority of cases are undiagnosed.',
        source: 'American Academy of Sleep Medicine',
        link: 'https://aasm.org/',
      },
    ],
  },
  {
    section: 'The cost of poor sleep',
    items: [
      {
        figure: '$411 billion',
        text: 'per year — the estimated cost of sleep deprivation to the US economy (about 2.28% of GDP).',
        source: 'RAND Europe, "Why Sleep Matters" (2016)',
        link: 'https://www.rand.org/',
      },
      {
        figure: '1.2 million',
        text: 'working days are lost in the US every year due to insufficient sleep, per the same RAND analysis.',
        source: 'RAND Europe, "Why Sleep Matters" (2016)',
        link: 'https://www.rand.org/',
      },
      {
        figure: '91,000',
        text: 'police-reported crashes in the US in 2017 involved drowsy drivers, per federal traffic safety data.',
        source: 'NHTSA (2017 data)',
        link: 'https://www.nhtsa.gov/',
      },
    ],
  },
  {
    section: 'Stress and sleep',
    items: [
      {
        figure: '~3 in 4',
        text: 'US adults report stress-related symptoms — headaches, fatigue, or disrupted sleep — in a given month.',
        source: 'American Psychological Association, Stress in America',
        link: 'https://www.apa.org/',
      },
      {
        figure: '7–9 hours',
        text: 'is the recommended sleep duration for healthy adults aged 18–64 (7–8 hours for adults 65+).',
        source: 'National Sleep Foundation (2015 recommendations)',
        link: 'https://www.sleepfoundation.org/',
      },
      {
        figure: '~1 in 6',
        text: 'US workers are on non-daytime shift schedules — a pattern strongly associated with sleep disruption.',
        source: 'US Bureau of Labor Statistics',
        link: 'https://www.bls.gov/',
      },
    ],
  },
  {
    section: 'Sleep supplement use (our niche)',
    items: [
      {
        figure: '3.1 million',
        text: 'US adults used melatonin in 2012 (1.3% of adults) — and published NHANES analyses show use roughly doubled across the 2010s.',
        source: 'CDC NCHS Data Brief; JAMA (2022)',
        link: 'https://www.cdc.gov/nchs/',
      },
      {
        figure: '~50%',
        text: 'of US adults consume less magnesium than the estimated average requirement from food alone.',
        source: 'NHANES dietary analyses (USDA/ARS)',
        link: 'https://www.ars.usda.gov/',
      },
      {
        figure: '97%',
        text: 'of Reddit posts with explicit outcome language about glycine were positive in 2026 — the highest approval of any major sleep supplement.',
        source: 'Naturally Restful, Sleep Supplement Reality Index (2026)',
        link: 'https://naturallyrestful.xyz/data/',
      },
    ],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How many adults do not get enough sleep?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'About 1 in 3 US adults report regularly sleeping less than the recommended 7 hours per night, according to CDC Behavioral Risk Factor Surveillance System data.',
      },
    },
    {
      '@type': 'Question',
      name: 'What percentage of adults have insomnia?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Roughly one-third of adults worldwide report at least one insomnia symptom, and about 10% of adults meet the criteria for chronic insomnia disorder, per the American Academy of Sleep Medicine.',
      },
    },
    {
      '@type': 'Question',
      name: 'How much does sleep deprivation cost the economy?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'RAND Europe estimates that sleep deprivation costs the US economy up to $411 billion per year, or about 2.28% of GDP, and loses about 1.2 million working days annually.',
      },
    },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Sleep Statistics: The Most-Cited Numbers, Properly Sourced (2026)',
  description:
    'A regularly-updated hub of sleep statistics — how much we sleep, insomnia rates, the economic cost of sleep loss, and sleep supplement use — each attributed to its original source.',
  datePublished: '2026-10-12',
  author: { '@type': 'Person', name: 'The Researcher', url: 'https://naturallyrestful.xyz/author' },
  publisher: { '@type': 'Organization', name: 'Naturally Restful', url: 'https://naturallyrestful.xyz' },
  about: [{ '@type': 'Thing', name: 'sleep statistics' }, { '@type': 'Thing', name: 'insomnia' }],
};
---

<BaseLayout
  title="Sleep Statistics — The Most-Cited Numbers, Properly Sourced"
  description="How much do we really sleep? The most-cited sleep statistics from CDC, RAND, JAMA, and the APA — each attributed to its original source, updated for 2026."
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="container">
    <h1 class="page-title">Sleep Statistics: The Most-Cited Numbers, Properly Sourced</h1>
    <p class="lead">
      Every week a new sleep statistic goes viral — and half of them trace back to a press release
      about a mattress company. This page collects the numbers that are actually verifiable, each
      one attributed to the organization that produced it. Writers and researchers: cite freely —
      <a href="/press">ready-made citation formats are here</a>.
    </p>

    {stats.map((group) => (
      <section class="stat-group">
        <h2 class="section-title">{group.section}</h2>
        <div class="stat-grid">
          {group.items.map((s) => (
            <div class="stat-card">
              <span class="figure">{s.figure}</span>
              <p>{s.text}</p>
              <a class="source" href={s.link} rel="nofollow noopener" target="_blank">Source: {s.source} ↗</a>
            </div>
          ))}
        </div>
      </section>
    ))}

    <div class="prose">
      <h2>Our original data: the Sleep Supplement Reality Index</h2>
      <p>
        The supplement statistics above that carry our name come from the
        <a href="/data">Sleep Supplement Reality Index</a> — our own continuously-updated dataset of
        community-reported outcomes for twelve sleep supplements, built from thousands of discussion
        threads. If you write about sleep supplements and need a citable number for what users actually
        report experiencing, <a href="/data">that page is the source</a> — and our
        <a href="/best-sleep-supplements-reddit">Reddit-verdict ranking</a> puts those numbers in context.
      </p>

      <h2>Frequently asked questions</h2>
      <h3>How many adults do not get enough sleep?</h3>
      <p>About 1 in 3 US adults report regularly sleeping less than the recommended 7 hours per night (CDC).</p>
      <h3>What percentage of adults have insomnia?</h3>
      <p>Roughly one-third of adults worldwide report at least one insomnia symptom; about 10% meet criteria for chronic insomnia disorder.</p>
      <h3>How much does sleep deprivation cost the economy?</h3>
      <p>Up to $411 billion per year in the US alone — about 2.28% of GDP — per RAND Europe's analysis.</p>

      <p class="fine">
        Last reviewed October 2026. External statistics are summarized from the named sources and
        linked at domain level; follow through to the source for exact confidence intervals and
        methodology. Statistics on this page are descriptive public-health figures, not medical advice.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .stat-group { margin: 2.4rem 0; }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
  .stat-card { background: #f4f1ea; border-radius: 12px; padding: 1.3rem 1.4rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .stat-card .figure { font-size: 1.9rem; font-weight: 700; color: #33517a; letter-spacing: -0.02em; }
  .stat-card p { margin: 0; font-size: 0.95rem; color: #333; flex-grow: 1; }
  .stat-card .source { font-size: 0.78rem; color: #777; text-decoration: none; }
  .stat-card .source:hover { color: #33517a; }
  .fine { font-size: 0.85rem; color: #777; }
</style>
