---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisclosureBlock from '../../components/DisclosureBlock.astro';
import AffiliateBox from '../../components/AffiliateBox.astro';
import AdSlot from '../../components/AdSlot.astro';
import EmailOptin from '../../components/EmailOptin.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const wordCount = article.body ? article.body.split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Ad policy: informational articles may carry ad slots.
// Review/comparison pages exist to send visitors to affiliate offers — they stay ad-free.
const allowAds = article.data.type === 'article';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.pubDate.toISOString(),
  dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Fahim', url: 'https://naturallyrestful.xyz/author' },
  publisher: { '@type': 'Organization', name: 'Naturally Restful', url: 'https://naturallyrestful.xyz' },
};
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="container">
    <header class="article-header">
      <span class="tag">{article.data.type === 'article' ? 'Guide' : article.data.type === 'review' ? 'Review' : 'Comparison'}</span>
      <h1>{article.data.title}</h1>
      <p class="article-meta">
        By <a href="/author">Fahim</a> ·
        <time datetime={article.data.pubDate.toISOString()}>{dateFmt(article.data.pubDate)}</time>
        {article.data.updatedDate && (
          <span> · Updated <time datetime={article.data.updatedDate.toISOString()}>{dateFmt(article.data.updatedDate)}</time></span>
        )}
        <span> · {readingTime} min read</span>
      </p>
    </header>

    <DisclosureBlock />

    <div class="prose">
      <Content />
    </div>

    {article.data.products?.map((p) => (
      <AffiliateBox name={p.name} slug={p.slug} blurb={p.blurb} badge={p.badge} />
    ))}

    {allowAds && <AdSlot id="after-article" />}
  </article>

  <div class="container">
    <EmailOptin />
  </div>
</BaseLayout>
