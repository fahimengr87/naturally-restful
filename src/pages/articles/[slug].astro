---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisclosureBlock from '../../components/DisclosureBlock.astro';
import AffiliateBox from '../../components/AffiliateBox.astro';
import AdSlot from '../../components/AdSlot.astro';
import EmailOptin from '../../components/EmailOptin.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const wordCount = article.body ? article.body.split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));

// Related articles: tokenized-title overlap scoring (stopwords removed)
const STOP = new Set(['for', 'the', 'a', 'an', 'of', 'to', 'vs', 'and', 'or', 'in', 'on', 'at', 'is', 'it', 'your', "you're", 'can', 'do', 'does', 'what', 'how', 'why', 'worth', 'best', 'more', 'from']);
const tokens = (t) => t.toLowerCase().split(/[^a-z0-9]+/).filter((w) => w.length > 2 && !STOP.has(w));
const thisTokens = new Set(tokens(article.data.title));
const allOthers = (await getCollection('articles')).filter((a) => a.id !== article.id);
const related = allOthers
  .map((a) => {
    const score = tokens(a.data.title).filter((w) => thisTokens.has(w)).length;
    return { a, score };
  })
  .sort((x, y) => y.score - x.score || y.a.data.pubDate.valueOf() - x.a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((x) => x.a);

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Ad policy: informational articles may carry ad slots.
// Review/comparison pages exist to send visitors to affiliate offers — they stay ad-free.
const allowAds = article.data.type === 'article';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.pubDate.toISOString(),
  dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Fahim', url: 'https://naturallyrestful.xyz/author' },
  publisher: { '@type': 'Organization', name: 'Naturally Restful', url: 'https://naturallyrestful.xyz' },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://naturallyrestful.xyz' },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: 'https://naturallyrestful.xyz/articles' },
    { '@type': 'ListItem', position: 3, name: article.data.title },
  ],
};
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <article class="container">
    <header class="article-header">
      <span class="tag">{article.data.type === 'article' ? 'Guide' : article.data.type === 'review' ? 'Review' : 'Comparison'}</span>
      <h1>{article.data.title}</h1>
      <p class="article-meta">
        By <a href="/author">Fahim</a> ·
        <time datetime={article.data.pubDate.toISOString()}>{dateFmt(article.data.pubDate)}</time>
        {article.data.updatedDate && (
          <span> · Updated <time datetime={article.data.updatedDate.toISOString()}>{dateFmt(article.data.updatedDate)}</time></span>
        )}
        <span> · {readingTime} min read</span>
      </p>
    </header>

    <DisclosureBlock />

    <div class="prose">
      <Content />
    </div>

    {article.data.products?.map((p) => (
      <AffiliateBox name={p.name} slug={p.slug} blurb={p.blurb} badge={p.badge} />
    ))}

    {allowAds && <AdSlot id="after-article" />}
  </article>

  {related.length > 0 && (
    <section>
      <h2 class="section-title">Related guides</h2>
      <div class="card-grid">
        {related.map((a) => (
          <a class="card" href={`/articles/${a.id}`}>
            <h3>{a.data.title}</h3>
            <p>{a.data.description}</p>
            <div class="card-meta">
              {a.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="container">
    <EmailOptin />
  </div>
</BaseLayout>
